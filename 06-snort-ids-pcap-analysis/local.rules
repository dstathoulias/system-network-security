# Student Packet Rule
alert tcp any any -> 192.168.1.1 54321 \
    (msg:"DETECT Student Packet"; content:"Dimitris Stathoulias-2018030109"; sid:1000001; rev:1;)

# Ports Packets Rule: Catch-all rule for both protocols (TCP, UDP)
alert ip any any -> 192.168.1.2 any \
    (msg:"DETECT Port Packet"; content:"Dimitris Stathoulias-2018030109"; sid:1000002; rev:1;)

# Base64 Packet Rule
# Base64 encoded AM: 2018030109 is MjAxODAzMDEwOQ==
alert tcp any any -> 192.168.1.3 8080 \
    (msg:"DETECT Base64 Packet"; content:"MjAxODAzMDEwOQ=="; sid:1000003; rev:1;)

# Suspicious DNS Packet Rule
alert udp any any -> any 53 \
    (msg:"DETECT Suspicious DNS Packet Packet"; content:"malicious"; content:"example"; content:"com"; \
    sid:1000004; rev:1;)

# Ping Packet Rule
alert icmp any any -> 192.168.1.4 any \
    (msg:"DETECT Ping Packet"; content:"PingTest2025"; sid:1000005; rev:1;)


# Slammer Worm Rule
# Slammer Worm directs its attacks to port 1434 (Microsoft SQL Server)
# with a payload starting with 0x04 that triggers a buffer overflow
alert udp any any -> any 1434 \
    (msg:"DETECT Slammer Worm Packet"; content:"|04|", depth 1; sid:1000006; rev:1;)